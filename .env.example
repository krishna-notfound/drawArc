# drawArc environment variables. Copy to .env.local and fill in values. Never commit real values.
# Keys marked "required" must be set; the rest stay optional until the feature named in their comment activates them.

# Runtime (F00)
NODE_ENV=
# Log verbosity (F00): debug | info | warn | error
LOG_LEVEL=

# Neon pooled connection (runtime queries), required since F02
DATABASE_URL=
# Neon direct connection (Prisma CLI / migrations), required since F02
DATABASE_URL_UNPOOLED=
# Neon test database for L2 tests, tests only (F02+); optional, L2 tests skip without it
DATABASE_URL_TEST=

# Clerk server key, required since F02
CLERK_SECRET_KEY=
# Clerk webhook signing secret, required since F02
CLERK_WEBHOOK_SIGNING_SECRET=
# Clerk publishable key, required since F02
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
# Clerk routing, read by Clerk itself (F02)
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
# Clerk routing, read by Clerk itself (F02)
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
# Clerk routing, read by Clerk itself (F02)
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/editor
# Clerk routing, read by Clerk itself (F02)
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/editor

# Liveblocks secret key, F05 activates
LIVEBLOCKS_SECRET_KEY=
# Liveblocks webhook secret, F05 activates
LIVEBLOCKS_WEBHOOK_SECRET_KEY=
# Liveblocks dev server URL, tests only (F05)
NEXT_PUBLIC_LIVEBLOCKS_BASE_URL=

# Vercel Blob token, F13 (local/CI only; OIDC on Vercel)
BLOB_READ_WRITE_TOKEN=

# Trigger.dev secret key, M2 (F17)
TRIGGER_SECRET_KEY=

# End-to-end test users, tests only (F02)
E2E_USER_A_EMAIL=
# tests only (F02)
E2E_USER_A_PASSWORD=
# tests only (F12)
E2E_USER_B_EMAIL=
# tests only (F12)
E2E_USER_B_PASSWORD=
# Start the Liveblocks dev server for Playwright, tests only (F05): set to 1
E2E_LIVEBLOCKS=
