# drawArc environment variables. Copy to .env.local and fill in values. Never commit real values.
# Keys marked "required" must be set; the rest stay optional until the feature named in their comment activates them.

# Runtime (F00)
NODE_ENV=
# Log verbosity (F00): debug | info | warn | error
LOG_LEVEL=

# Neon pooled connection (runtime queries), required since F02
DATABASE_URL=
# Neon direct connection (Prisma CLI / migrations), required since F02
DATABASE_URL_UNPOOLED=
# Neon test database for L2 tests, tests only (F02+); optional, L2 tests skip without it
DATABASE_URL_TEST=

# Clerk server key, required since F02
CLERK_SECRET_KEY=
# Clerk webhook signing secret, required since F02
CLERK_WEBHOOK_SIGNING_SECRET=
# Clerk publishable key, required since F02
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
# Clerk routing, read by Clerk itself (F02)
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
# Clerk routing, read by Clerk itself (F02)
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
# Clerk routing, read by Clerk itself (F02)
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/editor
# Clerk routing, read by Clerk itself (F02)
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/editor

# Liveblocks secret key, required since F05 (the local dev server accepts only sk_localdev)
LIVEBLOCKS_SECRET_KEY=
# Liveblocks webhook signing secret, required since F05 (a locally generated whsec_ value is fine in development)
LIVEBLOCKS_WEBHOOK_SECRET_KEY=
# Liveblocks dev server URL for the browser and node clients, tests only (F05)
NEXT_PUBLIC_LIVEBLOCKS_BASE_URL=
# Enables the test-only room page (/e2e/room/[projectId]), tests only (F05): set to 1
NEXT_PUBLIC_E2E_HOOKS=

# Canonical site origin for metadata, sitemap and robots, F26 (set on Vercel once the F15 domain exists); optional, defaults to http://localhost:3000
NEXT_PUBLIC_SITE_URL=

# Vercel Blob token, F13 (local/CI only; OIDC on Vercel)
BLOB_READ_WRITE_TOKEN=

# Trigger.dev secret key, M2 (F17)
TRIGGER_SECRET_KEY=

# End-to-end test users, tests only (F02)
E2E_USER_A_EMAIL=
# tests only (F02)
E2E_USER_A_PASSWORD=
# tests only (F12)
E2E_USER_B_EMAIL=
# tests only (F12)
E2E_USER_B_PASSWORD=
# Start the Liveblocks dev server for Playwright, tests only (F05): set to 1
E2E_LIVEBLOCKS=
# Dev-server port for Playwright, tests only (parallel worktrees; default 3000)
E2E_PORT=
# Playwright worker count, tests only (default 4)
E2E_WORKERS=
# Deployed preview URL for `npm run e2e:preview`, tests only (F15): unset runs against a local dev server
E2E_BASE_URL=
