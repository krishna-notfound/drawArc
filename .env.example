# drawArc environment variables. Copy to .env.local and fill in values. Never commit real values.
# Every key is optional until the feature named in its comment activates it.

# Runtime (F00)
NODE_ENV=
# Log verbosity (F00): debug | info | warn | error
LOG_LEVEL=

# Neon pooled connection, F02 activates
DATABASE_URL=
# Neon direct connection for migrations, F02 activates
DATABASE_URL_UNPOOLED=
# Neon test branch, L2 tests only (F03+)
DATABASE_URL_TEST=

# Clerk server key, F02 activates
CLERK_SECRET_KEY=
# Clerk webhook signing secret, F02 activates
CLERK_WEBHOOK_SIGNING_SECRET=
# Clerk publishable key, F02 activates
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=

# Liveblocks secret key, F05 activates
LIVEBLOCKS_SECRET_KEY=
# Liveblocks webhook secret, F05 activates
LIVEBLOCKS_WEBHOOK_SECRET_KEY=
# Liveblocks dev server URL, tests only (F05)
NEXT_PUBLIC_LIVEBLOCKS_BASE_URL=

# Vercel Blob token, F13 (local/CI only; OIDC on Vercel)
BLOB_READ_WRITE_TOKEN=

# Trigger.dev secret key, M2 (F17)
TRIGGER_SECRET_KEY=

# End-to-end test users, tests only (F02)
E2E_USER_A_EMAIL=
# tests only (F02)
E2E_USER_A_PASSWORD=
# tests only (F12)
E2E_USER_B_EMAIL=
# tests only (F12)
E2E_USER_B_PASSWORD=
# Start the Liveblocks dev server for Playwright, tests only (F05): set to 1
E2E_LIVEBLOCKS=
